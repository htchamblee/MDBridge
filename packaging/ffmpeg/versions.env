# Pinned sources of MDBridge's video encoding libraries (docs/BUILDING.md, "Video encoding").
# Read by build_ffmpeg.sh (Linux) and windows/build_ffmpeg.ps1 (Windows): KEY=VALUE lines only.
# Every change here changes the CI cache key (hash of packaging/ffmpeg/**) and rebuilds.

# FFmpeg (LGPL 2.1 or later): libavcodec, libavformat, libavutil, libswscale
FFMPEG_VERSION=9.0.2
FFMPEG_GIT=https://github.com/FFmpeg/FFmpeg.git
FFMPEG_TAG=n9.0.2
FFMPEG_COMMIT=946fcce07b6dcd0331c8cc609192aeff5e1924f8

# SVT-AV1 (BSD 3-Clause Clear + Alliance for Open Media Patent License 1.0): the AV1 encoder
SVTAV1_VERSION=4.1.0
SVTAV1_GIT=https://gitlab.com/AOMediaCodec/SVT-AV1.git
SVTAV1_TAG=v4.1.0
SVTAV1_COMMIT=c04f951541ad600e0d9c10836f2ab7b9bc69816d

# Windows: vcpkg release whose ports build the same FFmpeg and SVT-AV1 versions with MSVC
VCPKG_GIT=https://github.com/microsoft/vcpkg.git
VCPKG_TAG=2026.10.16
VCPKG_COMMIT=9eec002df1cd109f8f104cd966a763daf9751489
