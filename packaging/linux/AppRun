#!/bin/sh
# MDBridge AppImage entry point.
#
#   ./MDBridge-x86_64.AppImage                      the interface
#   ./MDBridge-x86_64.AppImage project.mdatk.toml   the interface with that project
#   ./MDBridge-x86_64.AppImage COMMAND ...           the command line (--help lists the commands)
#
# A symbolic link to the AppImage named "mdbridge-gui" always starts the interface.
HERE="$(dirname "$(readlink -f "$0")")"
MDBRIDGE="$HERE/usr/bin/mdbridge"

# Minimal and server installs (a cluster node used over ssh -X, containers) may lack libraries that
# Qt needs and every desktop has (OpenGL / EGL dispatch, X11, fontconfig, freetype and what they
# need). The AppImage carries copies, each in a folder of its own (usr/lib/fallback/<name>/<name>),
# and supplies only those the host lacks: each missing one's folder goes on the library path, the
# others stay off it, so the host's copies always win (they belong to its graphics driver and its
# font set-up). A library counts as present when the dynamic loader's cache (ldconfig -p), a
# standard library folder or a folder of the caller's LD_LIBRARY_PATH has it.
# MDBRIDGE_APPRUN_DEBUG=1 lists on stderr which copies were supplied.
host_libs=" $({ ldconfig -p 2>/dev/null || /sbin/ldconfig -p 2>/dev/null; } |
    awk '/x86-64/ {printf "%s ", $1}') "
host_has() {
    case "$host_libs" in *" $1 "*) return 0 ;; esac
    old_ifs="$IFS"
    IFS=:
    for d in /usr/lib64 /lib64 /usr/lib/x86_64-linux-gnu /lib/x86_64-linux-gnu ${LD_LIBRARY_PATH:-}; do
        if [ -n "$d" ] && [ -e "$d/$1" ]; then
            IFS="$old_ifs"
            return 0
        fi
    done
    IFS="$old_ifs"
    return 1
}
supplied=""
fallback_path=""
for dir in "$HERE"/usr/lib/fallback/*/; do
    [ -d "$dir" ] || continue
    lib="$(basename "$dir")"
    if ! host_has "$lib"; then
        supplied="$supplied $lib"
        fallback_path="$fallback_path${fallback_path:+:}${dir%/}"
    fi
done
if [ -n "$fallback_path" ]; then
    # the copies' own dependencies that the AppImage bundles anyway (usr/lib) resolve there
    LD_LIBRARY_PATH="$fallback_path:$HERE/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    export LD_LIBRARY_PATH
fi
if [ -n "${MDBRIDGE_APPRUN_DEBUG:-}" ]; then
    echo "AppRun: fallback libraries supplied:${supplied:- none}" >&2
fi
unset host_libs supplied fallback_path dir lib old_ifs

# fontconfig (bundled as a fallback library above) without the host's configuration: the AppImage's
# minimal one. Figures use MDBridge's compiled-in fonts and draw without a display in any case.
if [ -z "${FONTCONFIG_FILE:-}" ] && [ ! -e /etc/fonts/fonts.conf ]; then
    FONTCONFIG_FILE="$HERE/usr/share/mdbridge/fontconfig/fonts.conf"
    export FONTCONFIG_FILE
fi

# X11, also in Wayland sessions (through XWayland): the AppImage has no Wayland platform plugin yet.
# The commands that draw without a window (render, charts, preview, fonts, demo --run) use "offscreen" instead
# (set by the program), so they need no display.
QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-xcb}"
export QT_QPA_PLATFORM

case "$(basename "${ARGV0:-$0}")" in
    mdbridge-gui*) exec "$MDBRIDGE" gui "$@" ;;
esac
if [ $# -eq 0 ]; then
    exec "$MDBRIDGE" gui
fi
if [ $# -eq 1 ] && [ -f "$1" ]; then  # a project file (double-click / "Open with")
    exec "$MDBRIDGE" gui "$1"
fi
exec "$MDBRIDGE" "$@"
