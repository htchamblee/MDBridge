       "file": "apt1_01_amber-prod_20261125-1200.sh",
       "text": "#!/bin/bash\n# Amber production\n# Project apt1, step 01 - written by MDBridge <VERSION> on <DATE>.\n# MDBridge only writes this script; review it, then run it with: bash apt1_01_amber-prod_20261125-1200.sh\n# Amber 26; engine pmemd.MPI.\n# Please cite (AmberTools, pmemd (Amber), CPPTRAJ):\n#   - Case D. A., Aktulga H. M., Belfon K., Cerutti D. S., Cisneros G. A., Cruzeiro V. W. D.,\n#     Forouzesh N., Giese T. J., Götz A. W., Gohlke H., et al. J. Chem. Inf. Model. 2023, 63,\n#     6183-6191. doi:10.1021/acs.jcim.3c01153\n#   - Salomon-Ferrer R., Götz A. W., Poole D., Le Grand S., Walker R. C. J. Chem. Theory Comput.\n#     2013, 9, 3878-3888. doi:10.1021/ct400314y\n#   - Götz A. W., Williamson M. J., Xu D., Poole D., Le Grand S., Walker R. C. J. Chem. Theory\n#     Comput. 2012, 8, 1542-1555. doi:10.1021/ct200909j\n#   - Roe D. R., Cheatham T. E. J. Chem. Theory Comput. 2013, 9, 3084-3095. doi:10.1021/ct400341p\n\nset -eo pipefail\ncd \"$(dirname \"$0\")\"\n\nPMEMD=\"mpirun -np 8 pmemd.MPI\"\nTOP=\"/x/sys.parm7\"\n\n# a stage counts as finished when its output has the final timing lines\n# (pmemd: \"Total wall time\", sander: \"Run   done at\")\nfinished() { [ -s \"$1\" ] && grep -qE \"Total wall time|Run +done at\" \"$1\"; }\n\n# prod: Production, helix pairs held\nif finished apt1_01_prod_20261125-1200.out; then\n  echo \"prod: already finished - skipping\"\nelse\n  $PMEMD -O -i apt1_01_prod_20261125-1200.in -p \"$TOP\" -c apt1_01_eq-free_20261125-1200.rst7 -ref apt1_01_eq-free_20261125-1200.rst7 -o apt1_01_prod_20261125-1200.out -r apt1_01_prod_20261125-1200.rst7 -x apt1_01_prod_20261125-1200.nc -inf apt1_01_prod_20261125-1200.mdinfo\nfi\n[ -s \"apt1_01_prod_20261125-1200.rst7\" ] || { echo \"ERROR: pmemd (prod) did not write apt1_01_prod_20261125-1200.rst7\" >&2; exit 1; }\n"
      }
