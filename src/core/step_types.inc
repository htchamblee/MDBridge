std::vector<StepType> builtinStepTypes() {
    std::vector<StepType> out;
    out.reserve(16);
    out.push_back(stepTypeAmberBuild());
    out.push_back(stepTypeAmberRestraints());
    out.push_back(stepTypeAmberMd());
    out.push_back(stepTypeStructureBuilder());
    out.push_back(stepTypeRestraintDicts());
    out.push_back(stepTypeFarfar2());
    out.push_back(stepTypeFarfar2Models());
    out.push_back(stepTypeGromacs());
    out.push_back(stepTypeNote());
    out.push_back(stepTypeInputFile());
    out.push_back(stepTypeMdatk());
    out.push_back(stepTypePhenixRsr());
    out.push_back(stepTypeCootRsr());
    out.push_back(stepTypeRnamake());
    out.push_back(stepTypeSimrna());
    out.push_back(stepTypeVmd());
    return out;
}

